# =============================================================================
# Algo-Trade-Delta environment variables
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# =============================================================================

# Delta Exchange API credentials (get from https://www.delta.exchange/in/ → Settings → API)
DELTA_API_KEY=your_api_key_here
DELTA_API_SECRET=your_api_secret_here

# Delta Exchange base URL (India instance)
DELTA_BASE_URL=https://api.india.delta.exchange

# SQLite database path
DB_PATH=trading.db

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# How often the bot wakes to check for a new closed candle (minutes)
CHECK_INTERVAL_MINUTES=60

# Paper trading mode: True = simulate only (no real orders), False = live trading
DRY_RUN=True
